@model IntelliBroadcast.Web.ViewModels.AnnouncementsViewModel
@{ ViewData["Title"] = "Announcements"; }
<div class="page-heading"><div><p class="eyebrow">COMMUNICATION CENTRE</p><h1>Announcements</h1><p class="text-secondary mb-0">The latest global and organisation updates.</p></div><div class="count-pill">@Model.TotalCount total</div></div>
<section class="content-card" aria-live="polite">
@if (ViewData["LoadError"] is string error) { <div class="alert alert-danger m-4" role="alert">@error</div> }
else if (Model.Items.Count == 0) { <div class="empty-state"><div class="empty-icon" aria-hidden="true">✦</div><h2>No announcements yet</h2><p>Updates for your organisation will appear here.</p></div> }
else { <div class="table-responsive"><table class="table announcement-table mb-0"><thead><tr><th scope="col">Announcement</th><th scope="col" class="date-column">Date</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td><div class="message-title">@item.Message @if(item.IsGlobal){<span class="badge global-badge">Global</span>}</div>@if(!string.IsNullOrWhiteSpace(item.Description)){<div class="message-description">@item.Description</div>}</td><td class="date-column"><time datetime="@item.CreatedDate.ToString("yyyy-MM-dd")">@item.CreatedDate.ToString("dd MMM yyyy")</time></td></tr> }
</tbody></table></div><nav class="pagination-wrap" aria-label="Announcements pages"><span>Page @Model.Page of @Model.TotalPages</span><div class="btn-group"><a class="btn btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")" asp-route-page="@(Model.Page - 1)" aria-disabled="@(!Model.HasPrevious)">Previous</a><a class="btn btn-outline-secondary @(Model.HasNext ? "" : "disabled")" asp-route-page="@(Model.Page + 1)" aria-disabled="@(!Model.HasNext)">Next</a></div></nav> }
</section>
