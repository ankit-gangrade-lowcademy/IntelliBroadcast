<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - IntelliBroadcast</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><header class="app-header"><nav class="navbar navbar-expand-lg navbar-dark container" aria-label="Main navigation">
<a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">IB</span><span>IntelliBroadcast</span></a>
@if (User.Identity?.IsAuthenticated == true) {
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="mainNav"><ul class="navbar-nav me-auto ms-lg-4"><li class="nav-item"><a class="nav-link" asp-controller="Announcements" asp-action="Index">Announcements</a></li></ul><span class="user-email me-3">@User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-light btn-sm px-3" type="submit">Logout</button></form></div>
} else { <a class="btn btn-light btn-sm px-3 ms-auto" asp-controller="Account" asp-action="Login">Login</a> }
</nav></header><main class="container content-shell" role="main">@RenderBody()</main>
<footer class="container app-footer"><span>&copy; @DateTime.UtcNow.Year IntelliBroadcast</span><span>Secure communications, clearly delivered.</span></footer>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
