@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="state-card state-error"><span class="state-icon">!</span><h1>Something went wrong</h1><p>Please try again. If the problem continues, contact your administrator.</p>@if (Model.ShowRequestId) { <small>Request ID: <code>@Model.RequestId</code></small> }</div>
