@model AnnouncementIndexViewModel
@{ ViewData["Title"] = "Announcements"; }
<div class="page-heading"><div><span class="eyebrow">Communication centre</span><h1>Announcements</h1><p>Latest updates for your organisation and the Norvia community.</p></div><div class="count-pill">@Model.TotalCount total</div></div>
<div asp-validation-summary="ModelOnly" class="alert alert-warning" role="alert"></div>
@if (ViewData["LoadError"] is string error)
{
    <div class="state-card state-error" role="alert"><span class="state-icon">!</span><h2>We couldn't load announcements</h2><p>@error</p><a asp-action="Index" class="btn btn-brand">Try again</a></div>
}
else if (Model.Items.Count == 0)
{
    <div class="state-card"><span class="state-icon">✦</span><h2>No announcements yet</h2><p>New announcements will appear here when they are published.</p></div>
}
else
{
    <section class="content-card" aria-label="Announcement list">
        <div class="table-responsive">
            <table class="table announcement-table align-middle mb-0">
                <thead><tr><th scope="col">Announcement</th><th scope="col" class="date-column">Published</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr><td><div class="message-row"><span class="announcement-dot" aria-hidden="true"></span><div><div class="message-title">@item.Message @if (item.IsGlobal) { <span class="global-badge">Global</span> }</div>@if (!string.IsNullOrWhiteSpace(item.Description)) { <div class="message-description">@item.Description</div> }</div></div></td><td class="date-column"><time datetime="@item.CreatedDate.ToString("yyyy-MM-dd")">@item.CreatedDate.ToString("dd MMM yyyy")</time></td></tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-wrap" aria-label="Announcements pages"><span>Page @Model.Page of @Model.TotalPages</span><ul class="pagination mb-0"><li class="page-item @(Model.Page <= 1 ? "disabled" : null)"><a class="page-link" asp-route-page="@(Model.Page - 1)" aria-label="Previous">Previous</a></li><li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-route-page="@(Model.Page + 1)" aria-label="Next">Next</a></li></ul></nav>
        }
    </section>
}
