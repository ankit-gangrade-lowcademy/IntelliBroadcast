@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<div class="login-visual" aria-hidden="true"><div class="broadcast-rings"><span></span><span></span><span></span><i>IB</i></div><p>Clear communication.<br />Connected teams.</p></div>
<section class="login-card" aria-labelledby="login-title">
    <div class="login-brand"><span class="brand-mark">IB</span><div><strong>IntelliBroadcast</strong><small>Secure announcement portal</small></div></div>
    <div class="login-copy"><span class="eyebrow">Welcome back</span><h1 id="login-title">Sign in to your account</h1><p>Use your registered Norvia account details.</p></div>
    <form method="post" novalidate>
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
        <div class="mb-3"><label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" class="form-control" autocomplete="username" autofocus /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
        <button type="submit" class="btn btn-brand w-100">Sign in securely</button>
    </form>
    <p class="login-help">Having trouble signing in? Contact your administrator.</p>
</section>
