<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#6d28d9" />
    <title>@ViewData["Title"] - IntelliBroadcast</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    <header class="app-header">
        <nav class="navbar navbar-expand-lg container-xl" aria-label="Primary navigation">
            <a class="navbar-brand" asp-controller="Announcements" asp-action="Index"><span class="brand-mark" aria-hidden="true">IB</span><span>IntelliBroadcast</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNav" aria-controls="primaryNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="primaryNav">
                <div class="navbar-nav ms-lg-4">
                    <a class="nav-link @(controller == "Announcements" ? "active" : null)" asp-controller="Announcements" asp-action="Index">Announcements</a>
                </div>
                <div class="ms-lg-auto d-flex align-items-center gap-3 user-actions">
                    <span class="user-name">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-brand btn-sm" type="submit">Logout</button></form>
                </div>
            </div>
        </nav>
    </header>
}
<main class="@(User.Identity?.IsAuthenticated == true ? "container-xl app-main" : "login-shell")">
    @RenderBody()
</main>
@if (User.Identity?.IsAuthenticated == true)
{
    <footer class="app-footer"><div class="container-xl">IntelliBroadcast <span aria-hidden="true">·</span> Powered by Norvia</div></footer>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
